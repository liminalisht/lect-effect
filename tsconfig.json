{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "dist",
    "lib": ["esnext"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@lect-effect/domain": ["./packages/domain/src/index"],
      "@lect-effect/domain/*": ["./packages/domain/src/*"],
      "@lect-effect/services": ["./packages/services/src/index"],
      "@lect-effect/services/*": ["./packages/services/src/*"],
      "@lect-effect/handlers": ["./packages/handlers/src/index"],
      "@lect-effect/handlers/*": ["./packages/handlers/src/*"]
    },
    "plugins": [
      {
        "name": "@effect/language-service"
      }
    ]
  },
  "include": ["src", "test", "tests", "packages/domain/src", "packages/services/src", "packages/handlers/src"],
  "exclude": ["node_modules"]
}
