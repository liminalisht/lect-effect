{
  "name": "@lect-effect/backend",
  "version": "1.0.0",
  "private": true,
  "homepage": "https://github.com/liminalisht/lect-effect",
  "type": "module",
  "main": "./dist/src/index.js",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "pnpm run typecheck:test && env-cmd -f ../../.env.test --no-override vitest run --no-file-parallelism",
    "start": "pnpm run build && env-cmd -f ../../.env --no-override node dist/src/index.js",
    "docs:generate": "docgen --project tsconfig.json --src ./src/ --out ../../docs/src/content/docs/backend/ --exclude \"**/test/**\" --exclude \"**/*.d.ts\"",
    "install": "pnpm --dir ../.. install --filter ./apps/backend --frozen-lockfile",
    "install:nofreeze": "pnpm --dir ../.. install --filter ./apps/backend --no-frozen-lockfile"
  },
  "dependencies": {
    "@lect-effect/domain": "workspace:*",
    "@effect/platform-node": "^0.104.0",
    "@effect/sql": "^0.49.0",
    "@effect/sql-pg": "^0.50.1",
    "@gqloom/core": "^0.15.0",
    "@gqloom/effect": "^0.13.0",
    "dotenv": "^17.2.3",
    "effect": "^3.19.15",
    "graphql": "^16.12.0",
    "graphql-yoga": "^5.18.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@effect/docgen": "^0.5.2",
    "@effect/language-service": "^0.64.1",
    "@effect/vitest": "^0.27.0",
    "@tsconfig/node24": "^24.0.3",
    "@types/node": "^25.0.3",
    "env-cmd": "^11.0.0",
    "fast-check": "^4.5.3",
    "node-pg-migrate": "^8.0.4",
    "vitest": "^3.2.4",
    "xo": "^1.2.3"
  },
  "packageManager": "pnpm@10.22.0"
}
