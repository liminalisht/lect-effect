componentDiagram

@config(
  {
  "themeConfig": {
    "theme": "larkDark"
  },
  "sequence": {},
  "er": {},
  "component": {
    "edgeType": "curved",
    "hideGroupType": true
  },
  "activity": {},
  "mindmap": {}
})


node "live" {
  () "config" as liveConfig
  node "live deployed services" {
    () "frontend" as liveFrontend
    () "backend" as liveBackend

  }
  node "live service dependencies" {
    () "APIs" as liveApis
    () "DBs" as liveDatabases
  }
}
node "test" {
  node "test deployed services" {
    () "frontend" as testFrontend
    () "backend" as testBackend


  }

  node "test service dependencies" {
    () "APIs" as testApis
    () "DBs" as testDatabases
  }

  () "config" as testConfig

}

package "lect-effect" {

  package "@lect-effect/domain" {
    () schemas
    () types
    () validations
  }
  package "@lect-effect/services" {
    () services
    () interfaces
  }
  package "@lect-effect/handlers" {
    () effects
    () handlers
  }
  package "@lect-effect/backend" {
    () "backend app" as backend
    folder "src/graphql" {
      () server
      () resolvers
      () graphqlschema
    }
    folder "src/services" {
      () implementations
      () layers
    }
  }
  package "@lect-effect/frontend" {
    () "effects" as frontendEffects
    () "services" as frontendServices
    () components
    () pages
    () "frontend app" as frontend
  }
  package "@lect-effect/cli" {
    () cli
  }
  package "@lect-effect/docs" {
    () "docs app" as docsapp
  }

}

() devs

devs --> cli
devs --> docsapp
devs --> lect-effect
devs --> live
devs --> test


testBackend ..> testApis
testBackend ..> testDatabases
types ..> schemas
validations ..> schemas
interfaces ..> types
services ..> interfaces
liveFrontend ..> liveConfig
liveBackend ..> liveConfig
liveFrontend ..> frontend
liveBackend ..> backend
liveFrontend ..> liveBackend
testFrontend ..> testConfig
testBackend ..> testConfig
testFrontend ..> frontend
testBackend ..> backend
testFrontend ..> testBackend
frontendEffects ..> backend
frontendEffects ..> types
frontendEffects ..> validations
frontendServices ..> frontendEffects
components ..> frontendServices
components ..> types
components ..> validations
pages ..> components
frontend ..> components
frontend ..> pages
frontend ..> backend
liveBackend ..> liveDatabases
liveBackend ..> liveApis
resolvers ..> handlers
graphqlschema ..> resolvers
server ..> graphqlschema
server ..> resolvers
implementations ..> types
implementations ..> interfaces
layers ..> implementations
layers ..> services
backend ..> server
backend ..> layers
effects ..> types
effects ..> services
handlers ..> schemas
handlers ..> effects
