componentDiagram

@config(
  {
  "themeConfig": {
    "theme": "larkLight"
  },
  "sequence": {},
  "er": {},
  "component": {
    "edgeType": "curved"
  },
  "activity": {},
  "mindmap": {}
}
)

  package "lect-effect" {

    package "@lect-effect/domain" {
      () schemas
      () types
      () validations
    }

    types ..> schemas
    validations ..> schemas

    package "@lect-effect/services" {
      () services
      () interfaces
    }

    interfaces ..> types
    services ..> interfaces

    package "@lect-effect/handlers" {
      () effects
      () handlers
    }

    effects ..> types
    effects ..> services

    handlers ..> schemas
    handlers ..> effects


    package "@lect-effect/backend" {

      () "backend app" as backend


      folder "src/graphql" {
        () server
        () resolvers
        () graphqlschema
      }

      folder "src/services" {
        () implementations
        () layers
      }

    }

    resolvers ..> handlers
    graphqlschema ..> resolvers
    server ..> graphqlschema
    server ..> resolvers

    implementations ..> types
    implementations ..> interfaces
    layers ..> implementations
    layers ..> services

    backend ..> server
    backend ..> layers



    implementations ..> apis
    implementations ..> dbs

    package "@lect-effect/frontend" {
      () "effects" as frontendEffects
      () "services" as frontendServices
      () components
      () pages
      () "frontend app" as frontend

    }

    frontendEffects ..> backend
    frontendEffects ..> types
    frontendEffects ..> validations
    frontendServices ..> frontendEffects
    components ..> frontendServices
    components ..> types
    components ..> validations
    pages ..> components

    frontend ..> components
    frontend ..> pages
    frontend ..> backend

    package "@lect-effect/cli" {
      () cli
    }

    cli ..> frontend
    cli ..> backend

    package "@lect-effect/docs" {
      () docssite
    }
  }

  rectangle "people" {
    () users
    () devs
  }

  users ..> frontend
  users ..> docssite

  devs ..> cli
  devs ..> frontend
  devs ..> backend
  devs ..> docssite

  () "users" as users
  users ..> frontend

  node "external services" {


    cloud "external apis" {
      () apis
    }

    database "databases" {
      () dbs
    }
  }
