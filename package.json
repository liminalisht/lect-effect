{
  "name": "lect-effect",
  "version": "1.0.0",
  "description": "",
  "homepage": "https://github.com/liminalisht/lect-effect",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "buildtest": "pnpm run build && pnpm run typecheck:test",
    "docs:config": "docgen --project tsconfig.json --src ./src/domain/item --out ./docs/src/content/docs/generated/domain/item --exclude \"**/test/**\"",
    "docs:domain": "docgen --project tsconfig.json --src ./src/domain --out ./docs/src/content/docs/generated/domain --exclude \"**/test/**\"",
    "docs:handlers": "docgen --project tsconfig.json --src ./src/handlers --out ./docs/src/content/docs/generated/handlers --exclude \"**/test/**\"",
    "migrate:masterdata": "env-cmd -f .env --no-override node-pg-migrate --migration-filename-format utc -d MASTERDATA_PG_URL -m migrations/masterdatadb up",
    "migrate:test-masterdata": "env-cmd -f .env.test --no-override node-pg-migrate --migration-filename-format utc -d TEST_MASTERDATA_PG_URL -m migrations/masterdatadb up",
    "start": "pnpm run build && node dist/index.js",
    "test": "pnpm run buildtest && env-cmd -f .env.test --no-override vitest run",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.22.0",
  "volta": {
    "node": "24.12.0"
  },
  "dependencies": {
    "@effect/platform-node": "^0.104.0",
    "@effect/sql": "^0.49.0",
    "@effect/sql-pg": "^0.50.1",
    "@gqloom/core": "^0.15.0",
    "@gqloom/effect": "^0.13.0",
    "dotenv": "^17.2.3",
    "effect": "^3.19.14",
    "graphql": "^16.12.0",
    "graphql-yoga": "^5.18.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@effect/docgen": "^0.5.2",
    "@effect/language-service": "^0.64.1",
    "@effect/vitest": "^0.27.0",
    "@tsconfig/node24": "^24.0.3",
    "@types/node": "^25.0.3",
    "env-cmd": "^11.0.0",
    "fast-check": "^4.5.3",
    "node-pg-migrate": "^8.0.4",
    "vitest": "^3.2.4",
    "xo": "^1.2.3"
  }
}
