{
  "name": "lect-effect",
  "version": "1.0.0",
  "description": "",
  "homepage": "https://github.com/liminalisht/lect-effect",
  "main": "dist/src/index.js",
  "type": "module",
  "scripts": {
    "lect-effect": "pnpm run lect-effect/self:build && node dist/cli/index.js",
    "lect-effect/self:clean": "rm -rf dist/cli",
    "lect-effect/self:build": "pnpm run lect-effect/self:clean && pnpm exec tsc -p tsconfig.cli.json",
    "lect-effect/cli/docs:generate": "docgen --project tsconfig.json --src ./src/ --out ./docs/src/content/docs/cli/ --exclude \"**/test/**\" --exclude \"**/*.d.ts\"",
    "lect-effect/lint": "pnpx xo --ignore 'docs-site/**' --ignore 'apps/frontend/src/graphql/generated/**'",
    "lect-effect/migrate/masterdata:up": "env-cmd -f .env --no-override node-pg-migrate --migration-filename-format utc -d MASTERDATA_PG_URL -m apps/backend/migrations/masterdatadb up",
    "lect-effect/migrate/test-masterdata:up": "env-cmd -f .env.test --no-override node-pg-migrate --migration-filename-format utc -d TEST_MASTERDATA_PG_URL -m apps/backend/migrations/masterdatadb up"
  },
  "keywords": [],
  "author": "Abraham Howland",
  "license": "MIT",
  "packageManager": "pnpm@10.22.0",
  "volta": {
    "node": "24.12.0"
  },
  "dependencies": {
    "@effect/cli": "^0.73.1",
    "@effect/platform": "^0.94.2",
    "@effect/platform-node": "^0.104.0",
    "effect": "^3.19.15"
  },
  "devDependencies": {
    "@effect/docgen": "^0.5.2",
    "@effect/language-service": "^0.64.1",
    "@tsconfig/node24": "^24.0.3",
    "@types/node": "^25.0.3",
    "concurrently": "^9.0.0",
    "env-cmd": "^11.0.0",
    "node-pg-migrate": "^8.0.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "xo": "^1.2.3"
  }
}
