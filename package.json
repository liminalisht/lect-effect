{
  "name": "lect-effect",
  "version": "1.0.0",
  "description": "",
  "homepage": "https://github.com/liminalisht/lect-effect",
  "main": "dist/src/index.js",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist packages/domain/dist apps/web/dist apps/web/.angular/cache",
    "build": "pnpm -C packages/domain build && tsc",
    "buildtest": "pnpm run build && pnpm run typecheck:test",
    "docs:generate": "pnpm run docs:generate:app && pnpm -C packages/domain run docs:generate",
    "docs:generate:app": "docgen --project tsconfig.json --src ./src/ --out ./docs/src/content/docs/src/ --exclude \"**/test/**\"",
    "migrate:masterdata:up": "env-cmd -f .env --no-override node-pg-migrate --migration-filename-format utc -d MASTERDATA_PG_URL -m migrations/masterdatadb up",
    "migrate:test-masterdata:up": "env-cmd -f .env.test --no-override node-pg-migrate --migration-filename-format utc -d TEST_MASTERDATA_PG_URL -m migrations/masterdatadb up",
    "start": "pnpm run build && node dist/src/index.js",
    "test": "pnpm run buildtest && env-cmd -f .env.test --no-override vitest run --no-file-parallelism",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.22.0",
  "volta": {
    "node": "24.12.0"
  },
  "dependencies": {
    "@lect-effect/domain": "workspace:*",
    "@effect/platform-node": "^0.104.0",
    "@effect/sql": "^0.49.0",
    "@effect/sql-pg": "^0.50.1",
    "@gqloom/core": "^0.15.0",
    "@gqloom/effect": "^0.13.0",
    "dotenv": "^17.2.3",
    "effect": "^3.19.14",
    "graphql": "^16.12.0",
    "graphql-yoga": "^5.18.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@effect/docgen": "^0.5.2",
    "@effect/language-service": "^0.64.1",
    "@effect/vitest": "^0.27.0",
    "@tsconfig/node24": "^24.0.3",
    "@types/node": "^25.0.3",
    "env-cmd": "^11.0.0",
    "fast-check": "^4.5.3",
    "node-pg-migrate": "^8.0.4",
    "vitest": "^3.2.4",
    "xo": "^1.2.3"
  }
}
