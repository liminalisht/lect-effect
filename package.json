{
  "name": "lect-effect",
  "version": "1.0.0",
  "description": "",
  "homepage": "https://github.com/liminalisht/lect-effect",
  "main": "dist/src/index.js",
  "type": "module",
  "scripts": {
    "_clean": "rm -rf dist",
    "_build": "tsc",
    "_lint": "pnpx xo --ignore 'docs-site/**'",
    "_typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "_test": "pnpm run _typecheck:test && env-cmd -f .env.test --no-override vitest run --no-file-parallelism",
    "_install": "pnpm install --frozen-lockfile",
    "_install:nofreeze": "pnpm install --no-frozen-lockfile",

    "lect-effect/backend/clean": "pnpm -C apps/backend run lect-effect/backend/clean",
    "lect-effect/backend/build": "pnpm -C apps/backend run lect-effect/backend/build",
    "lect-effect/backend/test": "pnpm -C apps/backend run lect-effect/backend/test",
    "lect-effect/backend/start": "pnpm -C apps/backend run lect-effect/backend/start",
    "lect-effect/backend/docs:generate": "pnpm -C apps/backend run lect-effect/backend/docs:generate",
    "lect-effect/backend/clean:build": "pnpm -C apps/backend run lect-effect/backend/clean:build",
    "lect-effect/backend/clean:build:test": "pnpm -C apps/backend run lect-effect/backend/clean:build:test",
    "lect-effect/backend/install": "pnpm -C apps/backend run lect-effect/backend/install",
    "lect-effect/backend/install:nofreeze": "pnpm -C apps/backend run lect-effect/backend/install:nofreeze",

    "lect-effect/domain/clean": "pnpm -C packages/domain run lect-effect/domain/clean",
    "lect-effect/domain/build": "pnpm -C packages/domain run lect-effect/domain/build",
    "lect-effect/domain/test": "pnpm -C packages/domain run lect-effect/domain/test",
    "lect-effect/domain/docs:generate": "pnpm -C packages/domain run lect-effect/domain/docs:generate",
    "lect-effect/domain/clean:build": "pnpm -C packages/domain run lect-effect/domain/clean:build",
    "lect-effect/domain/clean:build:test": "pnpm -C packages/domain run lect-effect/domain/clean:build:test",
    "lect-effect/domain/install": "pnpm -C packages/domain run lect-effect/domain/install",
    "lect-effect/domain/install:nofreeze": "pnpm -C packages/domain run lect-effect/domain/install:nofreeze",

    "lect-effect/frontend/clean": "pnpm -C apps/frontend run lect-effect/frontend/clean",
    "lect-effect/frontend/build": "pnpm -C apps/frontend run lect-effect/frontend/build",
    "lect-effect/frontend/test": "pnpm -C apps/frontend run lect-effect/frontend/test",
    "lect-effect/frontend/start": "pnpm -C apps/frontend run lect-effect/frontend/start",
    "lect-effect/frontend/watch": "pnpm -C apps/frontend run lect-effect/frontend/watch",
    "lect-effect/frontend/serve:ssr": "pnpm -C apps/frontend run lect-effect/frontend/serve:ssr",
    "lect-effect/frontend/docs:generate": "pnpm -C apps/frontend run lect-effect/frontend/docs:generate",
    "lect-effect/frontend/clean:build": "pnpm -C apps/frontend run lect-effect/frontend/clean:build",
    "lect-effect/frontend/clean:build:test": "pnpm -C apps/frontend run lect-effect/frontend/clean:build:test",
    "lect-effect/frontend/clean:build:test:start": "pnpm -C apps/frontend run lect-effect/frontend/clean:build:test:start",
    "lect-effect/frontend/install": "pnpm -C apps/frontend run lect-effect/frontend/install",
    "lect-effect/frontend/install:nofreeze": "pnpm -C apps/frontend run lect-effect/frontend/install:nofreeze",

    "lect-effect/docs/clean": "pnpm -C docs run lect-effect/docs/clean",
    "lect-effect/docs/build": "pnpm -C docs run lect-effect/docs/build",
    "lect-effect/docs/dev": "pnpm -C docs run lect-effect/docs/dev",
    "lect-effect/docs/start": "pnpm -C docs run lect-effect/docs/start",
    "lect-effect/docs/preview": "pnpm -C docs run lect-effect/docs/preview",
    "lect-effect/docs/clean:build": "pnpm -C docs run lect-effect/docs/clean:build",
    "lect-effect/docs/install": "pnpm -C docs run lect-effect/docs/install",
    "lect-effect/docs/install:nofreeze": "pnpm -C docs run lect-effect/docs/install:nofreeze",

    "lect-effect/build": "pnpm run lect-effect/domain/build && pnpm run lect-effect/backend/build && pnpm run lect-effect/frontend/build && pnpm run lect-effect/docs/build",
    "lect-effect/clean": "pnpm run _clean && pnpm run lect-effect/domain/clean && pnpm run lect-effect/backend/clean && pnpm run lect-effect/frontend/clean && pnpm run lect-effect/docs/clean",
    "lect-effect/clean:build": "pnpm run lect-effect/clean && pnpm run lect-effect/build",
    "lect-effect/clean:build:test": "pnpm run lect-effect/clean:build && pnpm run lect-effect/test",
    "lect-effect/docs:generate": "pnpm run lect-effect/backend/docs:generate && pnpm run lect-effect/domain/docs:generate && pnpm run lect-effect/frontend/docs:generate",
    "lect-effect/install": "pnpm install --frozen-lockfile",
    "lect-effect/install:nofreeze": "pnpm install --no-frozen-lockfile",
    "lect-effect/lint": "pnpm run _lint",
    "lect-effect/run": "concurrently --names backend,frontend --prefix-colors blue,green \"pnpm run lect-effect/backend/start\" \"pnpm -C apps/frontend run lect-effect/frontend/start\"",
    "lect-effect/run:with-docs": "concurrently --names backend,frontend,docs --prefix-colors blue,green,magenta \"pnpm run lect-effect/backend/start\" \"pnpm -C apps/frontend run lect-effect/frontend/start\" \"pnpm -C docs run lect-effect/docs/dev\"",
    "lect-effect/test": "pnpm run lect-effect/domain/test && pnpm run lect-effect/backend/test && pnpm run lect-effect/frontend/test",

    "clean": "pnpm run lect-effect/clean",
    "build": "pnpm run lect-effect/domain/build && pnpm run lect-effect/backend/build",
    "lint": "pnpx xo --ignore 'docs-site/**'",
    "migrate:masterdata:up": "env-cmd -f .env --no-override node-pg-migrate --migration-filename-format utc -d MASTERDATA_PG_URL -m apps/backend/migrations/masterdatadb up",
    "migrate:test-masterdata:up": "env-cmd -f .env.test --no-override node-pg-migrate --migration-filename-format utc -d TEST_MASTERDATA_PG_URL -m apps/backend/migrations/masterdatadb up",
    "start": "pnpm run lect-effect/backend/start",
    "test": "pnpm run lect-effect/backend/test",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.22.0",
  "volta": {
    "node": "24.12.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@effect/language-service": "^0.64.1",
    "@tsconfig/node24": "^24.0.3",
    "@types/node": "^25.0.3",
    "concurrently": "^9.0.0",
    "env-cmd": "^11.0.0",
    "node-pg-migrate": "^8.0.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "xo": "^1.2.3"
  }
}
