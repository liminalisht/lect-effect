{
  "name": "@lect-effect/domain",
  "version": "1.0.0",
  "private": true,
  "homepage": "https://github.com/liminalisht/lect-effect",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {

    "lect-effect/packages/domain/clean:build:test:start": "pnpm run clean && pnpm run build && pnpm run test && pnpm run start",
    "lect-effect/packages/domain/clean:build:test": "pnpm run clean && pnpm run build && pnpm run test",
    "lect-effect/packages/domain/clean:build": "pnpm run clean && pnpm run build",
    "lect-effect/packages/domain/clean": "pnpm run clean",
    "lect-effect/packages/domain/build": "pnpm run build",
    "lect-effect/packages/domain/test": "pnpm run test",
    "lect-effect/packages/domain/docs:generate": "pnpm run docs:generate",

    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --dir test",
    "docs:generate": "docgen --project tsconfig.json --src ./src/ --out ../../docs/src/content/docs/domain/ --exclude \"**/test/**\""
  },
  "dependencies": {
    "effect": "^3.19.14"
  },
  "devDependencies": {
    "@effect/vitest": "^0.27.0",
    "fast-check": "^4.5.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
